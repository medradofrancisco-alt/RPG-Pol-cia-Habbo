{
  "manifest_version": 3,
  "name": "HUD RPG Polícia - Habbo",
  "version": "1.0",
  "description": "Painel de controle e HUD integrado para o Habbo RPG Polícia.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "https://www.habbo.com.br/*",
        "https://www.habbo.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
